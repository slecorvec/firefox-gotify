{
  "manifest_version": 3,
  "name": "Gotify Unread",
  "version": "0.1.0",
  "description": "Gotify notifications and an unread badge counting every message since you last read them, including those sent while Firefox was closed.",
  "icons": { "48": "icons/bell.svg", "96": "icons/bell.svg" },
  "permissions": ["alarms", "notifications", "storage"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "scripts": ["gotify.js", "background.js"] },
  "action": { "default_icon": "icons/bell.svg", "default_title": "Gotify", "default_popup": "popup.html" },
  "options_ui": { "page": "options.html", "open_in_tab": false },
  "browser_specific_settings": {
    "gecko": {
      "id": "gotify-unread@slecorvec",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
